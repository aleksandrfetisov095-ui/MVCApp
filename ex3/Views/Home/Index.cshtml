@model List<ex3.Models.Cat>
@{
    ViewData["Title"] = "Главная";
}

<h1 class="mb-4">Наши коты</h1>
<div class="row">
    @foreach (var cat in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <img src="@cat.PhotoSrc" class="card-img-top" alt="@cat.Name" style="height: 200px; object-fit: cover;">
                <div class="card-body">
                    <h5 class="card-title">@cat.Name</h5>
                    <p class="card-text">@cat.Description</p>
                    <p class="card-text"><small class="text-muted">Возраст: @cat.Age лет</small></p>
                    <a asp-action="Details" asp-route-id="@cat.Id" class="btn btn-primary">Подробнее</a>
                </div>
            </div>
        </div>
    }
</div>