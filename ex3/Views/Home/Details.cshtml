@model ex3.Models.Cat
@{
    ViewData["Title"] = Model.Name;
}

<div class="row">
    <div class="col-md-6">
        <img src="@Model.PhotoSrc" class="img-fluid rounded" alt="@Model.Name">
    </div>
    <div class="col-md-6">
        <h1>@Model.Name</h1>
        <p><strong>Возраст:</strong> @Model.Age лет</p>
        <p><strong>Описание:</strong> @Model.Description</p>
        <a asp-action="Index" class="btn btn-secondary">← Назад</a>
    </div>
</div>