@model ex3.Models.Cat
@{
    ViewData["Title"] = "Редактировать кота";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0">✏️ Редактировать кота</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" placeholder="Например: Барсик">
                        <span asp-validation-for="Name" class="text-danger fw-bold"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Age" class="form-label"></label>
                        <input asp-for="Age" type="number" class="form-control" min="0" max="30">
                        <span asp-validation-for="Age" class="text-danger fw-bold"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger fw-bold"></span>
                        <small class="form-text text-muted">От 10 до 500 символов</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhotoFile" class="form-label">📷 Загрузить новое фото</label>
                        <input asp-for="PhotoFile" type="file" class="form-control" accept="image/*">
                        <span asp-validation-for="PhotoFile" class="text-danger fw-bold"></span>
                        <small class="form-text text-muted">Оставь пустым, чтобы сохранить текущее фото</small>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.CurrentPhotoUrl))
                    {
                        <div class="mb-3">
                            <label class="form-label">Текущее фото:</label><br>
                            <img src="@Model.CurrentPhotoUrl" alt="@Model.Name"
                                 style="max-width: 200px; border-radius: 8px;"
                                 onerror="this.src='https://via.placeholder.com/200x150?text=No+Photo'">
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="BreedId" class="form-label"></label>
                        <select asp-for="BreedId" class="form-select" asp-items="ViewBag.Brands">
                            <option value="">-- Выберите породу --</option>
                        </select>
                        <span asp-validation-for="BreedId" class="text-danger fw-bold"></span>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-action="Index" class="btn btn-secondary">↩️ Отмена</a>
                        <button type="submit" class="btn btn-primary"> Сохранить изменения</button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}