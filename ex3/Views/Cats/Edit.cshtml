@model ex3.Models.Cat
@{
    ViewData["Title"] = "Редактировать кота";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0">✏️ Редактировать кота</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" placeholder="Например: Барсик">
                        <span asp-validation-for="Name" class="text-danger fw-bold"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Age" class="form-label"></label>
                        <input asp-for="Age" type="number" class="form-control" min="0" max="30">
                        <span asp-validation-for="Age" class="text-danger fw-bold"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger fw-bold"></span>
                        <small class="form-text text-muted">От 10 до 500 символов</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhotoSrc" class="form-label"></label>
                        <input asp-for="PhotoSrc" class="form-control" placeholder="https://media.istockphoto.com/id/1443562748/ru/%D1%84%D0%BE%D1%82%D0%BE/%D0%BC%D0%B8%D0%BB%D0%B0%D1%8F-%D1%80%D1%8B%D0%B6%D0%B0%D1%8F-%D0%BA%D0%BE%D1%88%D0%BA%D0%B0.jpg?s=612x612&w=0&k=20&c=k8RwP4usK_LCpQ1bPn3fNDLk3vtfptH7CEcEMZw_K1A=">
                        <span asp-validation-for="PhotoSrc" class="text-danger fw-bold"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="BreedId" class="form-label"></label>
                        <select asp-for="BreedId" class="form-select" asp-items="ViewBag.Brands">
                            <option value="">-- Выберите породу --</option>
                        </select>
                        <span asp-validation-for="BreedId" class="text-danger fw-bold"></span>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-action="Index" class="btn btn-secondary">↩️ Отмена</a>
                        <button type="submit" class="btn btn-primary">💾 Сохранить изменения</button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}