@model List<ex3.Models.Cat>
@{
    ViewData["Title"] = "Коты";
}

<form asp-action="Index" method="get" class="mb-4">
    <div class="input-group">
        <input type="text" name="searchName" class="form-control"
               placeholder="Поиск по имени..." value="@ViewBag.SearchName">
        <button type="submit" class="btn btn-primary">🔍 Найти</button>
        @if (!string.IsNullOrEmpty(ViewBag.SearchName))
        {
            <a asp-action="Index" class="btn btn-secondary">✕ Сбросить</a>
        }
    </div>
</form>

@if (Model == null || Model.Count == 0)
{
    <div class="alert alert-info text-center">
        😿 Коты не найдены. <a asp-action="Create">Добавить первого кота?</a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var cat in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <img src="@cat.PhotoSrc"
                         class="card-img-top"
                         alt="@cat.Name"
                         style="height: 200px; object-fit: cover;"
                         onerror="this.src='https://via.placeholder.com/300x200?text=No+Photo'">

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold">@cat.Name</h5>

                        @if (cat.Breed != null)
                        {
                            <p class="card-text text-muted small">🐾 @cat.Breed.Name</p>
                        }

                        <p class="card-text text-muted">🎂 @cat.Age лет</p>
                        <p class="card-text flex-grow-1">@cat.Description</p>

                        <div class="mt-auto d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@cat.Id" class="btn btn-outline-primary flex-grow-1">👁️ Подробнее</a>
                            <a asp-action="Edit" asp-route-id="@cat.Id" class="btn btn-outline-warning">✏️</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (ViewBag.TotalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">

            <li class="page-item @(ViewBag.CurrentPage <= 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-searchName="@ViewBag.SearchName"
                   asp-route-page="@(ViewBag.CurrentPage - 1)">← Назад</a>
            </li>

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-searchName="@ViewBag.SearchName"
                       asp-route-page="@i">@i</a>
                </li>
            }

            <li class="page-item @(ViewBag.CurrentPage >= ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-searchName="@ViewBag.SearchName"
                   asp-route-page="@(ViewBag.CurrentPage + 1)">Вперёд →</a>
            </li>

        </ul>
    </nav>
}