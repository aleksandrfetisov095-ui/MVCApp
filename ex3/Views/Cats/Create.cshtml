@model ex3.Models.Cat
@{
    ViewData["Title"] = "Добавить кота";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"> Добавить нового кота</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post" enctype="multipart/form-data">

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" placeholder="Например: Борис">
                        <span asp-validation-for="Name" class="text-danger fw-bold"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Age" class="form-label"></label>
                        <input asp-for="Age" type="number" class="form-control" min="0" max="30" placeholder="0">
                        <span asp-validation-for="Age" class="text-danger fw-bold"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Расскажите о коте..."></textarea>
                        <span asp-validation-for="Description" class="text-danger fw-bold"></span>
                        <small class="form-text text-muted">От 10 до 500 символов</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhotoFile" class="form-label">Загрузить фото</label>
                        <input asp-for="PhotoFile" type="file" class="form-control" accept="image/*">
                        <span asp-validation-for="PhotoFile" class="text-danger"></span>
                        <small class="form-text text-muted">Поддерживаются: JPG, PNG, GIF (макс. 5 МБ)</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="BreedId" class="form-label"></label>
                        @await Component.InvokeAsync("CategoryMenu")
                        <span asp-validation-for="BreedId" class="text-danger fw-bold"></span>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-action="Index" class="btn btn-secondary">↩️ Отмена</a>
                        <button type="submit" class="btn btn-success">💾 Сохранить</button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}