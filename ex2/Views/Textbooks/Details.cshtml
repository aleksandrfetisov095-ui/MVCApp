@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model ex2.Models.Textbook

<!DOCTYPE html>
<html>
<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/css/bootstrap.min.css">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 40px 0;
        }

        .book-detail-card {
            max-width: 900px;
            margin: 0 auto;
            border: none;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(0,0,0,0.2);
            transition: transform 0.3s ease;
        }

            .book-detail-card:hover {
                transform: translateY(-5px);
            }

        .book-image-container {
            position: relative;
            height: 450px;
            overflow: hidden;
            background: #f8f9fa;
        }

        .book-image {
            width: 100%;
            height: 100%;
            object-fit: contain;
            padding: 20px;
            transition: transform 0.5s ease;
        }

            .book-image:hover {
                transform: scale(1.05);
            }

        .book-info {
            padding: 30px;
        }

        .subject-badge-large {
            display: inline-block;
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            padding: 8px 20px;
            border-radius: 25px;
            font-size: 1rem;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .book-title {
            font-size: 2rem;
            font-weight: bold;
            color: #333;
            margin-bottom: 20px;
            border-left: 4px solid #764ba2;
            padding-left: 15px;
        }

        .info-section {
            margin-bottom: 20px;
            padding: 15px;
            background: #f8f9fa;
            border-radius: 10px;
        }

        .info-label {
            font-weight: bold;
            color: #764ba2;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 5px;
        }

        .info-value {
            font-size: 1.1rem;
            color: #555;
            line-height: 1.6;
        }

        .price-large {
            font-size: 2rem;
            font-weight: bold;
            color: #28a745;
        }

        .action-buttons {
            display: flex;
            gap: 15px;
            margin-top: 30px;
        }

        .btn-custom {
            flex: 1;
            padding: 12px;
            border-radius: 10px;
            font-weight: bold;
            transition: all 0.3s ease;
        }

        .btn-back {
            background: #6c757d;
            color: white;
            border: none;
        }

            .btn-back:hover {
                background: #5a6268;
                transform: translateY(-2px);
            }

        .btn-buy {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            border: none;
        }

            .btn-buy:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
            }
    </style>
</head>
<body>
    <div class="container">
        <div class="book-detail-card">
            <div class="row g-0">
                <div class="col-md-5">
                    <div class="book-image-container">
                        <img class="book-image" src="@Model.CoverUrl" alt="@Model.Title">
                    </div>
                </div>
                <div class="col-md-7">
                    <div class="book-info">
                        <span class="subject-badge-large">@Model.Subject</span>
                        <h1 class="book-title">@Model.Title</h1>

                        <div class="info-section">
                            <div class="info-label">Автор</div>
                            <div class="info-value">👤 @Model.Author</div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="info-section">
                                    <div class="info-label">Год издания</div>
                                    <div class="info-value">📅 @Model.Year</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-section">
                                    <div class="info-label">Страниц</div>
                                    <div class="info-value"> @Model.Pages</div>
                                </div>
                            </div>
                        </div>

                        <div class="info-section">
                            <div class="info-label">Цена</div>
                            <div class="info-value price-large">@Model.Price.ToString("C")</div>
                        </div>

                        <div class="info-section">
                            <div class="info-label">Описание</div>
                            <div class="info-value">@Model.Description</div>
                        </div>

                        <div class="action-buttons">
                            <a asp-controller="Textbooks" asp-action="Index" class="btn btn-custom btn-back">← Назад к списку</a>
                            <button class="btn btn-custom btn-buy">🛒 Купить</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.2.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js"></script>
</body>
</html>